# Application Discord — https://discord.com/developers/applications
# (onglet "OAuth2" de votre application Beep)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Doit correspondre EXACTEMENT à une "Redirect URI" enregistrée dans
# l'onglet OAuth2 de l'application Discord.
DISCORD_REDIRECT_URI=https://beep.renardis.fr/api/auth/callback

# Chaîne aléatoire utilisée pour signer les cookies de session.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
NODE_ENV=production

# API interne du bot Beep (voir Beep/bot.py + Beep/.env.example) — même
# VPS, jamais exposée sur Internet. BOT_API_SECRET doit être EXACTEMENT
# la même valeur que WEB_API_SECRET côté bot. Sans ça, les pages qui
# dépendent du bot (ex: Serveurs Minecraft) affichent une erreur au lieu
# de planter.
BOT_API_URL=http://127.0.0.1:8787
BOT_API_SECRET=
