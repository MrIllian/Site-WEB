# Application Discord — https://discord.com/developers/applications
# (onglet "OAuth2" de votre application Beep)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Doit correspondre EXACTEMENT à une "Redirect URI" enregistrée dans
# l'onglet OAuth2 de l'application Discord.
DISCORD_REDIRECT_URI=https://beep.renardis.fr/api/auth/callback

# Chaîne aléatoire utilisée pour signer les cookies de session.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000
NODE_ENV=production
